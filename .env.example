# DeepSeek generates the Douyin plans. It is tried for image recognition first.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Optional vision fallback if the configured DeepSeek model rejects image input.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
FLASK_SECRET_KEY=change-me
PORT=5000
